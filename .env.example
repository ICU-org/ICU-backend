# Скопируйте в .env и заполните. Сам .env в git не попадает.
PORT=5002
# development — стек ошибок уходит в ответ; на сервере обязательно production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug

DATABASE_URL="postgresql://user:password@localhost:5432/icu"

# Разрешённые origin фронтенда через запятую
CORS_ORIGINS=http://localhost:5174

# Часовой пояс для людей: границы периода выгрузки, даты в Excel
APP_TIMEZONE=Asia/Yerevan

# Служебная часть существует только для этих адресов (через запятую, можно подсети).
# Остальным /api/admin/* отвечает 404. Пусто — админка закрыта для всех.
ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Сколько часов живёт вход админа
ADMIN_SESSION_TTL_HOURS=12
# За reverse proxy: число прокси или "loopback". Без прокси — не задавать.
# TRUST_PROXY=1

# Куда сохранять загруженные файлы (логотипы партнёров). По умолчанию — ./uploads
# UPLOADS_DIR=/var/lib/icu/uploads
